# preprocess4conda_env

## go back to base
#CONDA_NO_PLUGINS=true conda remove conda-libmamba-solver libmamba libmambapy -n base -y

## preprocess to create the conda env list to reduce build time
conda remove --name cvm_explorer_conda_env --all
conda clean --all
conda create --name cvm_explorer_conda_env python=3.11 -y
conda activate cvm_explorer_conda_env
conda install conda-forge::gmt -y
conda install setuptools -y
conda install anaconda::pybind11 -y
conda install conda-forge::h5py -y
conda env export > cvm_explorer_conda_env.yml

