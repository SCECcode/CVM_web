FROM amazonlinux:2023

ENV CVM_WEB_TOP_DIR=/app/web
ENV PLOTTING_TOP_DIR=/usr/local/share/plotting
ENV ANACONDA3_TOP_DIR=/usr/local/share/anaconda3

ENV CVM_VOLUME=/usr/local/share/cvm_volume
ENV CVM_LARGEDATA_DIR=/usr/local/share/cvm-largedata-dir

ENV UCVM_TOP_DIR=/usr/local/share/ucvm
ENV UCVM_SRC_PATH=$UCVM_TOP_DIR/src
ENV UCVM_INSTALL_PATH=$UCVM_TOP_DIR/install
ENV CVM_IN_DOCKER='#'

WORKDIR /app

COPY . /app

COPY ./doc/cvm.conf /etc/httpd/conf.d/

RUN dnf upgrade -y --releasever=latest && \
    dnf install -y \
        httpd which gdb vi git wget tar proj \
        php8.3 php8.3-cli php8.3-pgsql php8.3-fpm && \
    dnf clean all && \
    rm -rf /var/cache/dnf && \
    php -v

RUN mkdir -p /run/php-fpm && chown -R apache:apache /run/php-fpm

RUN sed -i 's/^listen.acl_users =.*/;listen.acl_users =/' /etc/php-fpm.d/www.conf && \
    sed -i 's/^;listen.owner =.*/listen.owner = apache/' /etc/php-fpm.d/www.conf && \
    sed -i 's/^;listen.group =.*/listen.group = apache/' /etc/php-fpm.d/www.conf && \
    sed -i 's/^;listen.mode =.*/listen.mode = 0660/' /etc/php-fpm.d/www.conf

RUN /app/setup/run-web-setup

RUN source $UCVM_INSTALL_PATH/conf/ucvm_env.sh

## to allow environment variable to be passed down to php scripts
RUN sed -i 's/;clear_env = no/clear_env = no/g' /etc/php-fpm.d/www.conf

RUN echo -e '#!/bin/bash\nphp-fpm -D\nexec /usr/sbin/httpd -D FOREGROUND' > /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80

CMD ["/usr/local/bin/entrypoint.sh"]

